# GenUI — Environment Configuration
# Copy this file to .env.local to configure your environment variables.
# Never commit real API keys or secrets to git.

# ─── Anthropic Claude AI (Optional / Server-side) ───────────────────────────
# Optional: Used for AI reasoning, dynamic layout design, and qualitative synthesis.
# If omitted, GenUI runs in Direct Data Compilation mode with live online data.
ANTHROPIC_API_KEY=

# ─── External Data Provider Keys (Optional / Server-side) ────────────────────
# Open-Meteo & World Bank connectors are free and do not require API keys.
# Optional provider keys:
ALPHA_VANTAGE_API_KEY=
OPENWEATHER_API_KEY=
