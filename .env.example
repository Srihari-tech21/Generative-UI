# GenUI — Required Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local — it is already in .gitignore.

# ─── Clerk Authentication ────────────────────────────────────────────────────
# Get these from: https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_key
CLERK_SECRET_KEY=sk_test_replace_with_your_key

# Clerk redirect URLs (leave as-is for local dev; update in Clerk dashboard for prod)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ─── Database (Neon Postgres) ────────────────────────────────────────────────
# Get this from: https://console.neon.tech → your project → Connection string
# Must include ?sslmode=require for Neon
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── AI / Schema Generation ──────────────────────────────────────────────────
# Get this from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-replace_with_your_key

# ─── Optional: Offline / Demo Mode ───────────────────────────────────────────
# Set to "true" to skip live AI calls and serve cached example dashboards.
# Useful for demos without network access or when ANTHROPIC_API_KEY is not set.
OFFLINE_MODE=false
